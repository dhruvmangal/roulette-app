/**
 * {{pascalCase name}}Handler — generated by `npm run generate socket`.
 * One class per file, static methods as event handlers. Each receives the
 * decorated `({ payload, context }, ack)` args produced by
 * contextSocketMiddleware.
 */
export default class {{pascalCase name}}Handler {
{{#each eventList}}
  static async {{camelCase this}} ({ payload, context }, ack) {
    context.logger.info('{{pascalCase ../name}} {{pascalCase this}} Received', { message: payload })

    ack({ data: {}, errors: [] })
  }
{{#unless @last}}

{{/unless}}
{{/each}}
}
