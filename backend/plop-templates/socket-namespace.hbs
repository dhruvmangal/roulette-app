import { socketSchemaBuilder } from '~/libs/ajv'
import { SOCKET_NAMESPACES, SOCKET_ROOMS } from '~/utils/constants/socket'
import contextSocketMiddleware from '~/socket-resources/middlewares/contextSocket.middleware'
import requestValidationSocketMiddleware from '~/socket-resources/middlewares/requestValidationSocket.middleware'
import {{pascalCase name}}Handler from '~/socket-resources/handlers/{{camelCase name}}.handler'

// Per-event request/response schemas, compiled once at boot. Fill these in
// with real validation as each event's payload shape solidifies.
const schemas = socketSchemaBuilder({
{{#each eventList}}
  {{camelCase this}}: {
    request: { type: 'object' },
    response: { type: 'object' }
  }{{#unless @last}},{{/unless}}
{{/each}}
})

/**
 * @export
 * @param {import('socket.io').Server} io
 * {{pascalCase name}} namespace — generated by `npm run generate socket`.
 *
 * Middleware order matters here:
 *  - socket.use(contextSocketMiddleware(...)) runs on every incoming event
 *    and decorates the handler args into ({ payload, context }, ack).
 *  - socket.use(requestValidationSocketMiddleware) then validates the
 *    payload against that event's schema (if any).
 *  - socket.on(eventName, Handler.method) receives the decorated args.
 * Registering a middleware via socket.on() or a handler via socket.use()
 * breaks this silently — see CLAUDE.md.
 */
export default function (io) {
  const namespace = io.of(SOCKET_NAMESPACES.{{constantCase name}})

  namespace.on('connection', (socket) => {
    socket.join(SOCKET_ROOMS.{{constantCase name}}_ROOM)

    socket.use(contextSocketMiddleware(socket, schemas))
    socket.use(requestValidationSocketMiddleware)

{{#each eventList}}
    socket.on('{{camelCase this}}', {{pascalCase ../name}}Handler.{{camelCase this}})
{{/each}}
  })
}
