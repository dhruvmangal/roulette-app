import Flatted from 'flatted'
import Logger from '~/libs/logger'
import socketEmitter from '~/libs/socketEmitter'
import { ERROR_MSG } from '~/utils/constants/errors'
import { SOCKET_EMITTERS, SOCKET_NAMESPACES, SOCKET_ROOMS } from '~/utils/constants/socket'

/**
 * {{pascalCase name}}Emitter — generated by `npm run generate socket`.
 * For pushing server-initiated events to connected clients (e.g. from a
 * service, a cron job, or a webhook handler) outside a request/response
 * cycle.
 *
 * @export
 * @class {{pascalCase name}}Emitter
 */
export default class {{pascalCase name}}Emitter {
{{#each eventList}}
  static async emit{{pascalCase this}} (data) {
    try {
      data = Flatted.parse(Flatted.stringify(data))
      socketEmitter.of(SOCKET_NAMESPACES.{{constantCase ../name}}).to(SOCKET_ROOMS.{{constantCase ../name}}_ROOM).emit(SOCKET_EMITTERS.{{constantCase ../name}}_{{constantCase this}}, { data })
    } catch (error) {
      Logger.info('Error In Emitter', { message: ERROR_MSG.EMITTER_ERROR })
      Logger.info('Actual Error', { exception: error })
    }
  }
{{#unless @last}}

{{/unless}}
{{/each}}
}
