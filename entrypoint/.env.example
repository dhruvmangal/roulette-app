COMPOSE_PROJECT_NAME=roulette

POSTGRES_USER=roulette
POSTGRES_PASSWORD=roulette_dev_only
POSTGRES_DB=roulette
POSTGRES_PORT=5432

REDIS_PASSWORD=roulette_redis_dev_only
REDIS_PORT=6379

JWT_LOGIN_SECRET=replace-with-a-long-random-secret
JWT_LOGIN_TOKEN_EXPIRY=15m
# A different secret from JWT_LOGIN_SECRET, so one can't be used to forge the other.
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_TOKEN_EXPIRY=30d

# Sign in with Google / Apple. Leave empty to turn a provider off.
# Google: OAuth client IDs from Google Cloud Console (web, Android, iOS), comma-separated.
GOOGLE_CLIENT_IDS=
# Apple: the iOS app's bundle ID and the web Services ID, comma-separated.
APPLE_CLIENT_IDS=
# Play inside Discord as an Activity. From the Discord Developer Portal: the app's
# Application ID, and its OAuth2 client secret (keep it secret; never in the frontend).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Open invite and referral links in the mobile app instead of the browser. The site
# vouches for the app at /.well-known/; leave empty until the app is signed.
# iOS: the Apple Developer Team ID. Android: SHA-256 fingerprints of the signing
# certificates (Play Console > App signing), comma-separated.
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
# Push notifications (daily bonus ready, friend requests and invites, achievements). Leave empty to
# turn them off: the game works the same, players just aren't notified when away.
# Android: a Firebase service account key (Project settings > Service accounts) as JSON, or base64 of it.
FCM_SERVICE_ACCOUNT_JSON=
# iPhone: an Apple push key (.p8) as text or base64, its Key ID, and your Team ID. APNS_PRODUCTION is
# true for App Store and TestFlight builds and false for builds run from Xcode.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.roulette.game
APNS_PRODUCTION=false
# Admin app (http://localhost/admin/). A third secret, different from both above;
# leave empty to keep the admin app off.
JWT_ADMIN_SECRET=replace-with-a-third-long-random-secret
JWT_ADMIN_TOKEN_EXPIRY=8h
# Created at backend startup if no admin has this email (password: 10+ characters).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
SOCKET_ENCRYPTION_KEY=replace-with-a-long-random-key
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
ORIGIN=*
FRONTEND_URL=http://localhost
EXPO_PUBLIC_API_URL=http://localhost/api

PGADMIN_EMAIL=admin@example.local
PGADMIN_PASSWORD=admin_dev_only
PGADMIN_PORT=5050
REDISINSIGHT_PORT=5540
# Public address of the website (no trailing slash), for canonical links, sitemap.xml and robots.txt.
SITE_URL=
