{
  "name": "@roulette/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "iOS and Android apps: a Capacitor shell around the web app in frontend/",
  "scripts": {
    "web": "npm run build --workspace=@roulette/frontend",
    "sync": "npm run web && cap sync",
    "ios": "npm run web && cap run ios",
    "android": "npm run web && cap run android",
    "ios:open": "cap open ios",
    "android:open": "cap open android",
    "android:build": "npm run web && cap sync android && cd android && ./gradlew assembleDebug",
    "assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#07070b' --splashBackgroundColor '#07070b'",
    "build": "node -e \"console.log('Native builds run on demand: npm run android:build, or npm run ios (needs Xcode)')\"",
    "lint": "node -e \"console.log('No mobile lint')\"",
    "test": "node -e \"console.log('No mobile tests')\"",
    "typecheck": "node -e \"console.log('No mobile typecheck')\""
  },
  "dependencies": {
    "@capacitor-community/admob": "8.2.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/network": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3"
  }
}
